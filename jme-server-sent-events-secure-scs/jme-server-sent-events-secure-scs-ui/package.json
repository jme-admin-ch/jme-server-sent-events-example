{
  "name": "jme-server-sent-events-secure-scs-ui",
  "version": "1.0.0",
  "license": "Apache-2.0",
  "scripts": {
    "start": "ng serve",
    "start:4201": "ng serve --port 4201",
    "build": "ng build --base-href /jme-server-sent-events-secure-scs/",
    "build-dev": "ng build -c development --base-href /jme-server-sent-events-secure-scs/",
    "build-prod": "ng build -c production --base-href /jme-server-sent-events-secure-scs/",
    "test": "ng test",
    "test:ci": "ng test --watch=false --silent",
    "lint": "ng lint",
    "lint-fix": "ng lint --fix",
    "prettier": "./node_modules/.bin/prettier --write **/{*.ts,*.html,*.scss,*.json,*.js}",
    "format": "npm run lint -- --fix && npm run prettier",
    "check-licenses": "license-checker --production --excludePrivatePackages --excludePackages '@quadrel-enterprise-ui/auth@20.1.1;@quadrel-enterprise-ui/browser-check@20.0.1;@quadrel-enterprise-ui/framework@20.28.1;@quadrel-enterprise-ui/language@20.0.1' --onlyAllow 'MIT;Apache-2.0;BSD-2-Clause;BSD-3-Clause;0BSD;ISC'"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^20.3.27",
    "@angular/cdk": "^20.0",
    "@angular/common": "^20.3.27",
    "@angular/compiler": "^20.3.27",
    "@angular/core": "^20.3.27",
    "@angular/forms": "^20.3.27",
    "@angular/platform-browser": "^20.3.27",
    "@angular/platform-browser-dynamic": "^20.3.27",
    "@angular/router": "^20.3.27",
    "@ngrx/store": "^21.0.0",
    "@ngx-translate/core": "^17.0.0",
    "@ngx-translate/http-loader": "^17.0.0",
    "@popperjs/core": "^2.11.8",
    "@quadrel-enterprise-ui/auth": "20.1.1",
    "@quadrel-enterprise-ui/browser-check": "^20.0.1",
    "@quadrel-enterprise-ui/framework": "^20.4.1",
    "@quadrel-enterprise-ui/language": "^20.0.1",
    "ngx-translate-multi-http-loader": "^20.0.0",
    "rxjs": "~7.8.1",
    "tslib": "^2.8.1",
    "zone.js": "~0.16.0"
  },
  "devDependencies": {
    "@angular-builders/jest": "^20.0",
    "@angular-devkit/build-angular": "^20.0",
    "@angular-devkit/schematics": "^20.0",
    "@angular-eslint/builder": "^20.0",
    "@angular-eslint/eslint-plugin": "^20.0",
    "@angular-eslint/eslint-plugin-template": "^20.0",
    "@angular-eslint/template-parser": "^20.0",
    "@angular/build": "^20.0",
    "@angular/cli": "^20.0",
    "@angular/compiler-cli": "^20.3.27",
    "@types/jest": "30.0.0",
    "@types/node": "25.9.5",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "ajv": "^8.18.0",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-prettier": "^5.5.5",
    "jest": "30.4.2",
    "jest-environment-jsdom": "30.4.1",
    "jest-preset-angular": "17.0.0",
    "jest-sonar-reporter": "2.0.0",
    "license-checker": "^25.0.1",
    "prettier": "3.9.6",
    "typescript": "5.9.3"
  },
  "jestSonar": {
    "reportPath": "./coverage/sonarQube",
    "reportFile": "sqr.xml",
    "indent": 4,
    "sonar56x": true
  },
  "lint-staged": {
    "**/*.{js,ts,md,html,json}": [
      "prettier --write"
    ],
    "**/*.ts": [
      "ng-lint-staged lint --fix --"
    ]
  }
}
